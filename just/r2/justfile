# Delete residual proxy files at target directory | Search criteria '*/Proxy/*.mov'
[group('system')]
proxy dir='E:/Gaming':
	@found_count=0; \
	targets=(); \
	missing_masters=(); \
	while IFS= read -r -d '' proxy_file; do \
		parent_dir=$(dirname "$(dirname "$proxy_file")"); \
		filename_no_ext=$(basename "$proxy_file" .mov); \
		master_file="$parent_dir/$filename_no_ext.mp4"; \
		if [[ ! -f "$master_file" ]]; then \
			targets+=("$proxy_file"); \
			missing_masters+=("$filename_no_ext.mp4"); \
			((found_count++)); \
		fi; \
	done < <(find -L "{{dir}}" -type f -path "*/Proxy/*.mov" -print0); \
	\
	if [ "$found_count" -eq 0 ]; then \
		echo -e "{{green}}Scan complete. All proxy files have matching masters. Nothing to delete.{{reset}}"; \
	else \
		echo -e "{{yellow}}Found $found_count orphaned proxy file(s):{{reset}}"; \
		for i in "${!targets[@]}"; do \
			echo "  - ${targets[$i]}"; \
			echo "    [Master missing: ${missing_masters[$i]}]"; \
		done; \
		\
		echo -n -e "{{red}}Permanently delete these files? (y/N): {{reset}}"; \
		read -r confirm < /dev/tty; \
		if [[ "$confirm" == [yY] ]]; then \
			for file in "${targets[@]}"; do \
				echo "Deleting: $file"; \
				rm "$file"; \
			done; \
			echo -e "{{green}}Cleanup complete{{reset}}"; \
		else \
			echo "Operation cancelled by user."; \
		fi; \
	fi

# Commit this justfile if it changed	| snapshots history in D:\code\just\r2\.git
[group('system')]
r2-git msg='':
	@cd "D:\code\just\r2" ; \
	git add justfile ; \
	if git diff --cached --quiet ; then \
		echo -e "{{green}}justfile unchanged, nothing to commit{{reset}}" ; \
	else \
		stamp=$(date +%Y-%m-%d_%H-%M-%S) ; \
		msg="{{msg}}" ; \
		if [ -z "$msg" ]; then msg="Update justfile ($stamp)" ; fi ; \
		git commit -q -m "$msg" ; \
		echo -e "{{green}}Committed: $msg{{reset}}" ; \
	fi

# Open all rclone filter files
[group('system')]
ex:
	@pwsh -Command 'code (ls "D:\code\config\rclone\filters\*.txt")'
