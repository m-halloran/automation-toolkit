# Command layer. Recipes run under git-bash; heavier logic lives in the
# PowerShell and Python scripts alongside this repository.

set shell := ["D:/dev/git/bin/bash.exe", "-cu"]
set ignore-comments
set positional-arguments := true

# lists all recipes alphabetically
[group('admin')]
_list:
	@just --list

# Path to this justfile, for calling sub-recipes
r2 := "just --justfile D:/code/just/r2/justfile"

red := "\\033[91m"
green := "\\033[92m"
yellow := "\\033[93m"
white := "\\033[97m"
peach := "\\033[38;5;214m"
pink := "\\033[38;5;218m"
reset := "\\033[0m"

# Rclone filter layers, one variable per source volume. ORDER IS LOAD-BEARING:
# first match wins, so deny layers are listed before any file containing "+"
# rules. See config/rclone/README.md before editing.
#
# F: and G: take identical rules, so one variable serves both destinations.

filter-from_any := "\
--filter-from 'D:/code/config/rclone/filters/any-root-blacklist.txt'"

filter-from_c := "\
--filter-from 'D:/code/config/rclone/filters/any-root-blacklist.txt' \
--filter-from 'D:/code/config/rclone/filters/volume-root-blacklist.txt' \
--filter-from 'D:/code/config/rclone/filters/c-whitelist.txt'"

filter-from_d := "\
--filter-from 'D:/code/config/rclone/filters/any-root-blacklist.txt' \
--filter-from 'D:/code/config/rclone/filters/volume-root-blacklist.txt' \
--filter-from 'D:/code/config/rclone/filters/d-blacklist.txt' \
--filter-from 'D:/code/config/rclone/filters/dev-whitelist.txt'"

filter-from_e := "\
--filter-from 'D:/code/config/rclone/filters/any-root-blacklist.txt' \
--filter-from 'D:/code/config/rclone/filters/volume-root-blacklist.txt' \
--filter-from 'D:/code/config/rclone/filters/e-blacklist.txt'"

# Cloud sync flags, rename-tracking variant
drv-track-renames := "\
--check-first --modify-window 2s \
--track-renames --track-renames-strategy modtime,size \
--delete-after --delete-excluded \
--transfers 2 --checkers 4 --multi-thread-streams 0"

# Cloud sync flags
drv-flags := "\
--check-first --modify-window 2s \
--delete-after --delete-excluded \
--transfers 2 --checkers 4 --multi-thread-streams 0"

log := "\
--log-file D:/code/var/logs/r2-rclone/rclone.log --log-level INFO \
--log-file-max-size 100M --log-file-max-backups 15 -P"

# rclone			| cmd: sync, copy, move
[group('rclone:modular')]
rclone cmd src dest t='4' c='4':
	@flags=""; \
	case "{{cmd}}" in \
		sync) flags="--delete-after --delete-excluded" ;; \
		copy) flags="" ;; \
		move) flags="--delete-empty-src-dirs" ;; \
		*) exit 1 ;; \
	esac; \
	rclone {{cmd}} "{{src}}" "{{dest}}" {{filter-from_any}} --check-first $flags --transfers {{t}} --checkers {{c}} {{log}}

# System backup		| C:/ D:/ E:/ -> F:/ G:/
[group('rclone')]
sync:
	@echo "" ; {{r2}} _check-drives F:Fenrir G:Gamma

	@if [ -d "F:/" ]; then \
		{{r2}} sf ; \
	fi

	@if [ -d "G:/" ]; then \
		{{r2}} sg; \
	fi

	@{{r2}} drv

	@echo "" ; {{r2}} r2-git
	@{{r2}} _sync-summary

# F:/ backup targets	| C:/ D:/ E:/ -> F:/
[group('rclone')]
sf:
	@echo "" ; echo -e "{{yellow}}C:/ -> F:/{{reset}}"
	@rclone sync "C:/" "F:/r_arc/c_m2_evo" \
	--check-first --modify-window 2s --track-renames --track-renames-strategy modtime,size --delete-after --delete-excluded \
	--transfers 2 --checkers 4 --multi-thread-streams 0 {{filter-from_c}} {{log}}

	@echo "" ; echo -e "{{yellow}}D:/ -> F:/{{reset}}"

	@rclone sync "D:/" "F:/r_arc/d_m2_pro" \
	--check-first --modify-window 2s --delete-after --delete-excluded \
	--transfers 2 --checkers 6 --multi-thread-streams 0 {{filter-from_d}} {{log}}

	@echo "" ; echo -e "{{yellow}}E:/ -> F:/{{reset}}"

	@rclone sync "E:/" "F:/r_arc/e_hdd_4tb" \
	--check-first --modify-window 2s --delete-after --delete-excluded \
	--transfers 1 --checkers 4 --multi-thread-streams 0 {{filter-from_e}} {{log}}

	@rclone rmdirs "F:/r_arc"
	@echo "" ; echo -e "(F:) Fenrir	{{green}}Sync Complete{{reset}}"

# G:/ backup targets	| C:/ D:/ E:/ -> G:/
